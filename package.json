{
  "name": "encryptoid",
  "private": true,
  "description": "Encryptoid is a tool that encrypts and decrypts txt files.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/src/index.js",
    "build": "vite build",
    "test:smoke": "wdio run test/wdio.conf.js",
    "test:unit": "vitest run",
    "test:server": "vitest run --config server/vitest.config.js",
    "test:server:watch": "vitest --config server/vitest.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix:format": "pnpm lint:fix && pnpm format",
    "preview": "vite preview"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^15.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@wdio/cli": "^9.32.0",
    "@wdio/devtools-service": "10.9.1",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "vite": "^8.3.5",
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
